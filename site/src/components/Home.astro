---
import type { Strings } from "../i18n/pt";
import { pageUrl } from "../lib/urls";
import { REPO_URL } from "../lib/github";
import Shot from "./Shot.astro";
import Icon from "./Icon.astro";
import { Image } from "astro:assets";
import piggy from "../assets/icons3d/piggy.png";
import plane from "../assets/icons3d/plane.png";
import house from "../assets/icons3d/house.png";
import coins from "../assets/icons3d/coins.png";
import safe from "../assets/icons3d/safe.png";
import checklist from "../assets/icons3d/checklist.png";

interface Props {
  t: Strings;
  stars: number | null;
  version: string | null;
}
const { t, stars, version } = Astro.props;
const dl = pageUrl(t, "download");
const d = t.demo;
const f = t.frag;
const h1Words = t.hero.h1.split(" ");
const h1Head = h1Words.slice(0, -2).join(" ");
const h1Tail = h1Words.slice(-2).join(" ");
const polaroids = [
  { img: piggy, bg: "#ffe9ee" },
  { img: plane, bg: "#e4efff" },
  { img: house, bg: "#e6f6d8" },
  { img: coins, bg: "#fff0d6" },
  { img: safe, bg: "#efe6ff" },
  { img: checklist, bg: "#dff5f2" },
];
const sealIcons: Record<string, string> = { mit: "shield", sqlite: "db", telemetry: "lock", signed: "refresh" };
// The composition bar of the forecast card, as a graphic: share and colour of each part.
const parts = [
  { w: 13, c: "var(--bills-segment)" },
  { w: 34, c: "var(--chart-out)" },
  { w: 12, c: "var(--faint)" },
  { w: 41, c: "var(--primary)" },
];
const toneVar: Record<string, string> = {
  violet: "var(--chart-violet)",
  teal: "var(--chart-teal)",
  green: "var(--chart-green)",
  amber: "var(--chart-planned)",
};
---

<!-- Hero: copy on the left, the product as an interface on the right -->
<section class="hero">
  <div class="stickers" aria-hidden="true">
    {
      polaroids.map((p, i) => (
        <figure class={`polaroid s${i}`}>
          <div class="photo" style={`background:${p.bg}`}>
            <Image src={p.img} alt="" width={96} height={96} format="webp" loading="lazy" />
          </div>
          <figcaption>{t.polaroids[i]}</figcaption>
        </figure>
      ))
    }
  </div>
  <div class="wrap wide hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1>{h1Head} <span class="ul">{h1Tail}</span></h1>
      <p class="sub">{t.hero.sub}</p>
      <div class="cta-row">
        <a class="btn" href={dl}>{t.hero.cta}</a>
        <a class="btn ghost" href="#features">{t.hero.ctaSecondary}</a>
      </div>
    </div>

    <div class="stage" role="img" aria-label={d.label}>
      <div class="demo" aria-hidden="true">
        <div class="demo-top">
          <span class="demo-title"><b>t</b> trove</span>
          <ol class="demo-steps">
            {d.steps.map((s, i) => <li style={`--i:${i}`}>{s}</li>)}
          </ol>
        </div>
        <div class="demo-body">
          <div class="layer" style="--i:0">
            <div class="drop">
              <span class="drop-ic"><Icon name="file" size={22} /></span>
              <span class="drop-file">{d.file}</span>
              <span class="drop-meta">{d.fileMeta}</span>
            </div>
            <p class="drop-hint">{d.drop}</p>
          </div>
          <div class="layer" style="--i:1">
            <p class="layer-title">{d.previewTitle}</p>
            <div class="counts">
              <div><b class="num">42</b><span>{d.newLabel}</span></div>
              <div class="dim"><b class="num">8</b><span>{d.dupLabel}</span></div>
            </div>
            <div class="skel"><i></i><i></i><i></i></div>
          </div>
          <div class="layer" style="--i:2">
            <ul class="rows">
              {
                d.rows.map((r) => (
                  <li>
                    <span class="rname">{r.name}</span>
                    <span class="chip" style={`--tone:${toneVar[r.tone]}`}>{r.cat}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="layer" style="--i:3">
            <p class="layer-title">{d.closedTitle}</p>
            <p class="big num">{t.demo.balance.int}<small>{t.demo.balance.dec}</small></p>
            <div class="cbar">{parts.map((p) => <i style={`flex:${p.w};background:${p.c}`}></i>)}</div>
            <p class="drop-hint">{d.free}</p>
          </div>
        </div>
      </div>

      <div class="fcard tx" aria-hidden="true">
        <span class="fic" style="--tone:var(--chart-teal)"><Icon name="trend" size={18} /></span>
        <div>
          <b>{d.floatTx.name}</b>
          <span>{d.floatTx.cat}</span>
        </div>
        <em class="num">{d.floatTx.amount}</em>
      </div>
      <div class="fcard pace" aria-hidden="true">
        <span class="fl">{d.floatBar.title}</span>
        <div class="cbar">{parts.map((p) => <i style={`flex:${p.w};background:${p.c}`}></i>)}</div>
        <b class="num">{d.floatBar.free}</b>
      </div>
    </div>
  </div>
</section>

<!-- Seals: thin strip of verifiable facts -->
<section class="seals" aria-label="Trove">
  <div class="wrap wide">
    <ul>
      {
        t.seals.map((s) => (
          <li>
            <span class="seal-ic"><Icon name={sealIcons[s.key]} size={18} /></span>
            <span><b>{s.title}</b> {s.text}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Features: a bento of different widths, each with a piece of the interface -->
<section id="features">
  <div class="wrap wide">
    <p class="eyebrow">{t.features.eyebrow}</p>
    <h2>{t.features.h2}</h2>
    <p class="sub">{t.features.lead}</p>
    <div class="bento">
      {
        t.features.items.map((item, i) => (
          <article class={`bcard b${i}`}>
            <div class="frag" aria-hidden="true">
              {i === 0 && (
                <div class="shuf">
                  <div class="mini m0" style="--p0:0%;--p1:34.5%;--p2:69%">
                    <span class="fl">{f.layout[0]}</span>
                    <b class="num">{t.demo.balance.int}</b>
                    <div class="cbar">{parts.map((p) => <i style={`flex:${p.w};background:${p.c}`}></i>)}</div>
                  </div>
                  <div class="mini m1" style="--p0:34.5%;--p1:69%;--p2:0%">
                    <span class="fl">{f.layout[1]}</span>
                    <i class="sk"></i><i class="sk s"></i>
                  </div>
                  <div class="mini m2" style="--p0:69%;--p1:0%;--p2:34.5%">
                    <span class="fl">{f.layout[2]}</span>
                    <div class="mbars">{[40, 70, 50, 85].map((x) => <i style={`height:${x}%`}></i>)}</div>
                  </div>
                </div>
              )}
              {i === 1 && (
                <div class="reel">
                  <div class="reel-track">
                    {[0, 1, 2, 0, 1, 2].map((n) => (
                      <div class="fcard-s">
                        <span class="fic" style="--tone:var(--primary)"><Icon name="file" size={16} /></span>
                        <b>2026-{10 + n}.ofx</b>
                        <span class="chips"><span class="chip" style="--tone:var(--chart-teal)">{f.import.fresh}</span><span class="chip" style="--tone:var(--faint)">{f.import.dup}</span></span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              {i === 2 && (
                <div class="cyc">
                  {d.rows.map((r, k) => (
                    <div class="cy" style={`--i:${k};--tone:${toneVar[r.tone]}`}>
                      <span class="cy-ic"><Icon name={["fork", "car", "cart", "film"][k]} size={26} /></span>
                      <b>{r.name}</b>
                      <span class="chip" style={`--tone:${toneVar[r.tone]}`}>{r.cat}</span>
                    </div>
                  ))}
                </div>
              )}
              {i === 3 && (
                <div class="xfer">
                  <div class="acct"><Icon name="bank" size={18} /><span>{f.transfer.a}</span></div>
                  <div class="wire"><i class="coin"></i><span class="num">{t.frag.transfer.amount}</span></div>
                  <div class="acct"><Icon name="wallet" size={18} /><span>{f.transfer.b}</span></div>
                  <span class="chip" style="--tone:var(--faint)">{f.transfer.off}</span>
                </div>
              )}
              {i === 4 && (
                <div class="bars">
                  <div class="bar-row">
                    {[38, 52, 46, 64, 58, 80].map((h, k) => <i style={`height:${h}%;--k:${k}`}></i>)}
                  </div>
                  <span class="line"><b class="num">{f.flow.free}</b>{f.flow.caption}</span>
                </div>
              )}
              {i === 5 && (
                <div class="net">
                  <b class="num big">{f.net.value}</b>
                  <svg viewBox="0 0 160 48" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40 C20 38 30 30 50 32 S80 18 100 20 S130 8 160 4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
                  <span>{f.net.caption}</span>
                </div>
              )}
            </div>
            <div class="btext">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
    <ul class="small-list">
      {t.features.small.map((s) => <li>{s}</li>)}
    </ul>
  </div>
</section>

<!-- Showcase: the real app, dark band with three cards and a cropped screenshot -->
<div class="band-dark showcase-band" data-theme="dark">
  <div class="band-dark-in">
    <p class="eyebrow">{t.proof.eyebrow}</p>
    <h2>{t.proof.h2}</h2>
    <p class="sub">{t.proof.sub}</p>
    <p class="proof-links">
      {stars !== null && stars > 0 && <span>{t.proof.stars(stars)}</span>}
      {version && <span>{t.proof.version(version)}</span>}
      <a href={REPO_URL}>{t.proof.repo}</a>
    </p>
    <div class="showcase">
      <input class="sr" type="radio" name="shot-theme" id="st-light" checked />
      <input class="sr" type="radio" name="shot-theme" id="st-dark" />
      <fieldset class="tabs">
        <legend class="sr">{t.tabs.label}</legend>
        <label for="st-light">{t.tabs.light}</label>
        <label for="st-dark">{t.tabs.dark}</label>
      </fieldset>
      <div class="shots">
        <div class="frame main">
          <Shot route="overview" lang={t.code} alt={t.hero.alt} widths={[900, 1800]} sizes="(min-width: 1100px) 1100px, 100vw" />
        </div>
      </div>
    </div>
  </div>
</div>


<!-- Who it is for: 50/50 -->
<section class="who">
  <div class="wrap wide split">
    <div>
      <p class="eyebrow">{t.who.eyebrow}</p>
      <h2>{t.who.h2}</h2>
      <p class="sub">{t.who.lead}</p>
    </div>
    <div class="who-stack">
      <div class="who-card yes">
        <h3><span class="who-ic"><Icon name="check" size={16} /></span>{t.who.yesTitle}</h3>
        <ul>{t.who.yes.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="who-card no">
        <h3><span class="who-ic"><Icon name="x" size={16} /></span>{t.who.noTitle}</h3>
        <ul>{t.who.no.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<!-- Where the data lives: the dark band, with the local-first diagram -->
<div class="band-dark" id="security" data-theme="dark">
  <div class="band-dark-in">
    <p class="eyebrow">{t.data.eyebrow}</p>
    <h2>{t.data.h2}</h2>
    <div class="dcols">
      {
        t.data.cols.map((c) => (
          <div>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            {c.code && <code>{c.code}</code>}
          </div>
        ))
      }
    </div>
    <div class="diagram-wrap">
    <svg class="diagram" viewBox="0 0 900 210" role="img" aria-label={`${t.data.diagram.bank} → ${t.data.diagram.file} → ${t.data.diagram.app} → ${t.data.diagram.db}; ${t.data.diagram.app} → ${t.data.diagram.github} (${t.data.diagram.only})`}>
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="6" y="20" width="182" height="72" rx="16" />
        <rect x="246" y="20" width="182" height="72" rx="16" />
        <rect x="486" y="20" width="182" height="72" rx="16" stroke="var(--primary-text)" stroke-width="2" />
        <rect x="712" y="20" width="182" height="72" rx="16" />
        <path d="M188 56h58M428 56h58M668 56h44" />
        <path d="M578 92v56" stroke-dasharray="5 5" />
        <rect x="486" y="148" width="182" height="52" rx="16" stroke-dasharray="5 5" />
      </g>
      <g fill="currentColor" font-family="Inter, system-ui, sans-serif" font-size="17" font-weight="600" text-anchor="middle">
        <text x="97" y="62">{t.data.diagram.bank}</text>
        <text x="337" y="62">{t.data.diagram.file}</text>
        <text x="577" y="62">{t.data.diagram.app}</text>
        <text x="803" y="62">{t.data.diagram.db}</text>
        <text x="577" y="180">{t.data.diagram.github}</text>
      </g>
      <text x="592" y="126" fill="currentColor" font-family="Inter, system-ui, sans-serif" font-size="14" opacity="0.8">{t.data.diagram.only}</text>
    </svg>
    </div>
    <p class="data-quote">{t.quote.text} <span class="hand">{t.quote.hand}</span></p>
    <p class="data-note">{t.quote.note}</p>
    <p class="close">{t.data.close}</p>
  </div>
</div>


<!-- FAQ -->
<section id="faq">
  <div class="wrap">
    <p class="eyebrow">{t.faq.eyebrow}</p>
    <h2>{t.faq.h2}</h2>
    <div class="faq-list">
      {
        t.faq.items.map((q) => (
          <details>
            <summary>{q.q}</summary>
            <p>{q.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- Final call -->
<section class="final">
  <div class="wrap wide">
    <div class="final-in">
      <h2>{t.cta.h2}</h2>
      <div class="cta-row">
        <a class="btn light" href={dl}>{t.cta.button} <Icon name="arrow" size={18} /></a>
      </div>
      <p class="micro">{t.cta.micro}</p>
    </div>
  </div>
</section>
