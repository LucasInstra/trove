---
import type { Strings } from "../i18n/pt";
import { pt } from "../i18n/pt";
import { en } from "../i18n/en";
import { pageUrl, link } from "../lib/urls";
import { REPO_URL } from "../lib/github";

interface Props {
  t: Strings;
  page: keyof Strings["paths"];
}
const { t, page } = Astro.props;
const otherT = t.code === "en" ? pt : en;
---

<header class="nav">
  <div class="wrap wide">
    <div class="nav-pill">
      <a class="brand" href={pageUrl(t, "home")} aria-label="Trove">
        <span class="brand-mark" aria-hidden="true">t</span>
        Trove
      </a>
      <nav class="nav-links" aria-label={t.nav.label}>
        <a href={link(t, "#product")}>{t.nav.product}</a>
        <a href={link(t, "#features")}>{t.nav.features}</a>
        <a href={link(t, "#security")}>{t.nav.security}</a>
        <a href={link(t, "#faq")}>{t.nav.faq}</a>
        <a href={pageUrl(t, "changelog")}>{t.nav.changelog}</a>
        <a href={REPO_URL}>{t.nav.github}</a>
      </nav>
      <div class="nav-end">
        <button class="theme-btn" type="button" aria-label={t.nav.theme} title={t.nav.theme}>
          <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
        <a class="lang" href={pageUrl(otherT, page)} hreflang={otherT.lang} lang={otherT.lang}>
          {t.other.label}
        </a>
        <a class="btn small" href={pageUrl(t, "download")}>{t.nav.download}</a>
      </div>
    </div>
  </div>
</header>
